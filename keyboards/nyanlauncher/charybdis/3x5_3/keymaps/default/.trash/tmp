bool process_record_user(uint16_t keycode, keyrecord_t *record) {
    static uint16_t prev_time=0;// time of last key action
    static uint16_t kc_delay=0;// asynchronously delays the current action
    static bool sticky_mods=false;
    // Advanced Keycodes: {{{
    if (IS_MODTAP(keycode)) {
        if (record->tap.count) {// isn't mod
            keycode = MODTAP_GET_KEYCODE(keycode);
        } else {// is mod
            switch (MODTAP_GET_MODS(keycode)) {
            case MOD_MASK_CTRL:
                keycode = KC_LCTL;
                break;
            case MOD_MASK_SHIFT:
                keycode = KC_LSFT;
                break;
            case MOD_MASK_ALT:
                keycode = KC_LALT;
                break;
            case MOD_MASK_GUI:
                keycode = KC_LGUI;
                break;
            case MOD_BIT(KC_RCTL):
                keycode = KC_RCTL;
                break;
            case MOD_BIT(KC_RSFT):
                keycode = KC_RSFT;
                break;
            case MOD_BIT(KC_RALT):
                keycode = KC_RALT;
                break;
            case MOD_BIT(KC_RGUI):
                keycode = KC_RGUI;
                break;
            }
        }
    }
    //}}}
    // Simple Keycodes: {{{
    switch (keycode) {
    //Custom Keycodes:
    case TB_SCROLL:
        if (record->event.pressed) { tb_scroll=true; } else { tb_scroll=false; }
        keycode = KC_NO; break;
    case SCWC_ENABLE:
        if (record->event.pressed) scwc=true;
        keycode = KC_NO; break;
    case SCWC_DISABLE:
        if (record->event.pressed) scwc=false;
        keycode = KC_NO; break;
    case SCWC_TOGG:
        if (record->event.pressed) scwc=!scwc;
        keycode = KC_NO; break;
    case STICKY_MODS:
        if (record->event.pressed) sticky_mods=true;
        keycode = KC_NO; break;
    //case MS_SLW:
        if (record->event.pressed) {
            pointing_device_set_cpi(SLOW_CPI);
        } else {
            pointing_device_set_cpi(DEFAULT_CPI);
        }
        keycode = KC_NO; break;
    case MS_CPIU:
        if (record->event.pressed) {
            if ((pointing_device_get_cpi()+CPI_INCREMENT) <= 12000) {
                pointing_device_set_cpi(pointing_device_get_cpi()+CPI_INCREMENT);
            } else {
                pointing_device_set_cpi(12000);
            }
        }
        keycode = KC_NO; break;
    case MS_CPID:
        if (record->event.pressed) {
            if ((pointing_device_get_cpi()-CPI_INCREMENT) >= SLOW_CPI) {
                pointing_device_set_cpi(pointing_device_get_cpi()-CPI_INCREMENT);
            } else {
                pointing_device_set_cpi(SLOW_CPI);
            }
        }
        keycode = KC_NO; break;
    //===========================
    case KC_SCLN:
        if (get_mods() == MOD_MASK_CTRL) { keycode = KC_ESC; }
        break;
    }//}}}

    if (sticky_mods && IS_MOD(keycode) && record->event.pressed) {
        add_oneshot_mods(MOD_BIT(keycode));
    } 
    if (!sticky_mods) {
        clear_oneshot_mods();
    }

    //if (IS_MOD(keycode)) {
    //    delay=MOD_TIMEOUT;
    //}

    if (scwc) {// swap capslock and ctrl
        if (keycode==KC_LCTL) {
            keycode = KC_CAPS;
        } else if ((MODKEY_GET_MODS(keycode) & MOD_MASK_CTRL)) {
            if (record->event.pressed) {
                register_code(KC_CAPS);
                register_code(MODKEY_GET_KEYCODE(keycode));
            } else {
                unregister_code(KC_CAPS);
                unregister_code(MODKEY_GET_KEYCODE(keycode));
            }
            return false;
        } else if (keycode == KC_CAPS) {
            keycode = KC_LCTL;
        }
    }

    // send key record
    if (kc_delay > 0) {// delay key record
        return false;
    } else {// send normally
        if (record->event.pressed) {
            register_code(keycode);
        } else {
            unregister_code(keycode);
        }
        return false;
    }
    dprintf("key: 0x%x; pressed: %s; time:%s%dms (%d,%d)\n",
         keycode,
         record->event.pressed ? "true" : "false",
         record->event.pressed ? "  " : " +",
         (timer_read()-prev_time),
         record->event.key.col, record->event.key.row
    );
    kc_delay=0;// reset delay
    prev_time=timer_read();//used on next invocation
    return true;// if sum weird shit happens
}
report_mouse_t pointing_device_task_combined_user(report_mouse_t left_report, report_mouse_t right_report) {
    left_report.x=-left_report.x;
    left_report.h=-left_report.h;
    right_report.y=-right_report.y;
    right_report.v=-right_report.v;
    return pointing_device_combine_reports(left_report, right_report);
}
// Trackball Customization:
report_mouse_t pointing_device_task_user(report_mouse_t mouse_report) {
    static float scroll_accumulated_h = 0;
    static float scroll_accumulated_v = 0;
    if (tb_scroll) {
        // Calculate and accumulate scroll values based on mouse movement and divisors
        scroll_accumulated_h += (float)mouse_report.x / SCROLL_DIVISOR_H;
        scroll_accumulated_v += (float)(-mouse_report.y) / SCROLL_DIVISOR_V;
        // Assign integer parts of accumulated scroll values to the mouse report
        mouse_report.h = (int8_t)scroll_accumulated_h;
        mouse_report.v = (int8_t)scroll_accumulated_v;
        // Update accumulated scroll values by subtracting the integer parts
        scroll_accumulated_h -= mouse_report.h;
        scroll_accumulated_v -= mouse_report.h;
        // Clear the X and Y values of the mouse report
        mouse_report.x = 0;
        mouse_report.y = 0;
    }
    return mouse_report;
}
